{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": [
        "assets/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@models": [
        "src/types"
      ],
      "@models/*": [
        "src/types/*"
      ],
      "@utils/*": [
        "src/util/*"
      ],
      "@services/*": [
        "src/services/*"
      ]
    }
  }
}